# Copia este archivo como .env y ajusta los valores.

# --- Base de datos PostgreSQL ---
# Opción A (local): variables individuales.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=changeme
PGDATABASE=vitelsa_glasslab

# Opción B (producción / Neon / Vercel): una sola cadena de conexión.
# Si DATABASE_URL está definida, tiene prioridad sobre las PG* de arriba.
# Usa la cadena "pooled" de Neon (incluye -pooler) para entornos serverless.
# DATABASE_URL=postgresql://user:pass@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# --- Servidor ---
PORT=4000
NODE_ENV=development

# --- Autenticación del panel admin (Fase 4) ---
# Contraseña de EJEMPLO. Debe reemplazarse por el método real de VITELSA.
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
ADMIN_USERNAME=admin
ADMIN_PASSWORD=vitelsa-demo-2026

# Segundo usuario del panel: SOLO consulta de leads (no puede editar preguntas,
# reglas ni ciudades). Se crea con `npm run db:seed:admin` y solo si hay contraseña.
VIEWER_USERNAME=consulta
VIEWER_PASSWORD=

# --- Verificación de correo (OTP) ---
# El código de 6 dígitos se firma con JWT_SECRET (HMAC) y vence en 10 minutos.
# Con EMAIL_PROVIDER=console NO se envía correo real: el código se imprime en la
# consola del backend y viaja en la respuesta como `codigoDev` (solo si
# NODE_ENV != production). Para envío real usa EMAIL_PROVIDER=graph (o smtp).

# --- Integraciones (Fase 5) ---
# Proveedores de relleno por defecto: registran en consola y guardan en .outbox/.
# Cuando VITELSA entregue credenciales/formato, cambiar a los reales (ej. resend / sharepoint).
EMAIL_PROVIDER=console
LEAD_SYNC_PROVIDER=file
VITELSA_EMAIL=informacion@vitelsa.com.co
OUTBOX_DIR=.outbox

# Envío real por correo (SMTP). Para activarlo: EMAIL_PROVIDER=smtp
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true,
#        SMTP_USER=tucorreo@gmail.com, SMTP_PASS=<contraseña de aplicación de 16 dígitos>
# SMTP_USER=
# SMTP_PASS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_FROM=

# Envío desde el buzón compartido de VITELSA (Microsoft Graph).
# Para activarlo: EMAIL_PROVIDER=graph
#
# glasslab@vitelsa.com.co es un buzón COMPARTIDO: no tiene contraseña propia y
# por eso no sirve SMTP. Se envía en su nombre con una aplicación registrada en
# Entra ID (Azure AD) del tenant de VITELSA:
#   1. Entra ID → Registros de aplicaciones → Nuevo registro (p. ej. "VITELSA GlassLab").
#   2. Permisos de API → Microsoft Graph → Permisos de APLICACIÓN → Mail.Send
#      → "Conceder consentimiento del administrador".
#   3. Certificados y secretos → Nuevo secreto de cliente (anotar el VALOR, se
#      muestra una sola vez, y su fecha de vencimiento).
#   4. Recomendado: restringir la aplicación a este único buzón con una
#      ApplicationAccessPolicy en Exchange Online; sin eso, Mail.Send permite
#      enviar desde cualquier buzón del tenant.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER=glasslab@vitelsa.com.co
GRAPH_SENDER_NAME=VITELSA GlassLab
