# Copia este archivo como .env y ajusta los valores.

# --- Base de datos PostgreSQL ---
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=changeme
PGDATABASE=vitelsa_glasslab

# --- Servidor ---
PORT=4000
NODE_ENV=development

# --- Autenticación del panel admin (Fase 4) ---
# Contraseña de EJEMPLO. Debe reemplazarse por el método real de VITELSA.
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
ADMIN_USERNAME=admin
ADMIN_PASSWORD=vitelsa-demo-2026

# --- Integraciones (Fase 5) ---
# Proveedores de relleno por defecto: registran en consola y guardan en .outbox/.
# Cuando VITELSA entregue credenciales/formato, cambiar a los reales (ej. resend / sharepoint).
EMAIL_PROVIDER=console
LEAD_SYNC_PROVIDER=file
VITELSA_EMAIL=informacion@vitelsa.com.co
OUTBOX_DIR=.outbox
