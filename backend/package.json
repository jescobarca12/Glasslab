{
  "name": "vitelsa-glasslab-backend",
  "version": "0.1.0",
  "description": "API REST de VITELSA GlassLab: catálogo de vidrio, motor de reglas, diagnósticos/leads y gamificación.",
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --require ts-node/register --test src/**/*.test.ts",
    "verify": "ts-node --transpile-only scripts/verificar.ts",
    "email:probar": "ts-node --transpile-only scripts/probarCorreo.ts",
    "db:extract": "ts-node scripts/extractDemoData.ts",
    "db:migrate": "ts-node src/db/migrate.ts",
    "db:seed": "ts-node src/db/seed/seed.ts",
    "db:seed:admin": "ts-node src/db/seed/seedAdmin.ts",
    "db:seed:lab": "ts-node scripts/seedLabTopics.ts",
    "db:seed:retos": "ts-node scripts/seedCityChallenges.ts",
    "db:check:retos": "ts-node scripts/validarRetos.ts",
    "db:seed:portafolio": "ts-node scripts/seedPortafolio.ts",
    "db:reset": "ts-node src/db/migrate.ts --reset && ts-node src/db/seed/seed.ts && ts-node src/db/seed/seedAdmin.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^9.0.5",
    "pdf-lib": "^1.17.1",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.11.6",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.0"
  }
}
